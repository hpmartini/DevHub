# Frontend Build Stage
# Static output is arch-independent: build once on the runner's native platform instead of under QEMU
FROM --platform=$BUILDPLATFORM oven/bun:1.2.18-alpine AS bun
FROM --platform=$BUILDPLATFORM node:20-alpine AS builder
COPY --from=bun /usr/local/bin/bun /usr/local/bin/bun
RUN ln -s /usr/local/bin/bun /usr/local/bin/bunx

WORKDIR /app

# Copy package files
COPY package.json bun.lock ./

# Install dependencies - ignore optional native modules (node-pty is backend-only)
RUN bun install --frozen-lockfile --ignore-scripts

# Copy source files
COPY . .

# Build the frontend (Vite production build)
RUN bun run build

# Production Stage - Nginx
FROM nginx:alpine AS production

# Copy nginx config
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf

# Copy built frontend from builder
COPY --from=builder /app/dist /usr/share/nginx/html

# Expose port 80
EXPOSE 80

# Health check - verify nginx is running AND can reach the API
# This ensures the container is only marked healthy when fully operational
HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://localhost/health && \
      wget --no-verbose --tries=1 -O /dev/null http://localhost/api/health || exit 1

CMD ["nginx", "-g", "daemon off;"]
