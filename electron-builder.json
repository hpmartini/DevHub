{
  "appId": "com.devorbit.dashboard",
  "productName": "DevOrbitDashboard",
  "copyright": "Copyright \u00a9 2026",
  "directories": {
    "output": "dist-electron",
    "buildResources": "electron/resources"
  },
  "files": [
    "dist/**/*",
    "electron/**/*",
    "config/**/*",
    "!electron/**/*.md",
    "dist-server/**/*",
    "node_modules/**/*",
    "!node_modules/**/*.md",
    "!node_modules/**/test/**",
    "!node_modules/**/tests/**",
    "!node_modules/**/*.test.js",
    "!node_modules/**/*.spec.js",
    "!node_modules/**/.github/**",
    "!node_modules/**/docs/**",
    "!node_modules/**/examples/**",
    "package.json"
  ],
  "extraResources": [],
  "mac": {
    "category": "public.app-category.developer-tools",
    "target": ["dmg", "zip"],
    "darkModeSupport": true,
    "hardenedRuntime": false,
    "gatekeeperAssess": false
  },
  "dmg": {
    "contents": [
      {
        "x": 130,
        "y": 220
      },
      {
        "x": 410,
        "y": 220,
        "type": "link",
        "path": "/Applications"
      }
    ],
    "window": {
      "width": 540,
      "height": 380
    }
  },
  "linux": {
    "target": ["AppImage", "deb", "rpm"],
    "category": "Development",
    "synopsis": "Developer dashboard for managing local development applications",
    "description": "DevOrbit Dashboard is a comprehensive developer dashboard that monitors and manages local development applications with AI-powered insights."
  },
  "publish": {
    "provider": "github",
    "owner": "hpmartini",
    "repo": "DevHub"
  },
  "afterPack": "scripts/fix-node-pty-binaries.cjs",
  "afterSign": "electron/notarize.js",
  "asar": true,
  "asarUnpack": [
    "node_modules/**/*.node",
    "node_modules/node-pty/**/*",
    "node_modules/pidusage/**/*",
    "dist-server/**/*"
  ]
}
